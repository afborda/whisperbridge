{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperBridge",
  "version": "0.1.0",
  "identifier": "com.abner.whisperbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14287",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhisperBridge",
        "url": "http://127.0.0.1:37865/",
        "width": 520,
        "height": 560,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
