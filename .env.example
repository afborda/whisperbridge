# ─────────────────────────────────────────────────────────────────────────────
# WhisperBridge — copie para .env e preencha o que for usar.
# O .env está no .gitignore; este arquivo de exemplo pode ser versionado.
# ─────────────────────────────────────────────────────────────────────────────

# Identificação de falantes (pyannote). Sem isto, o app roda mas não separa
# "Pessoa 1 / Pessoa 2". Conta gratuita em huggingface.co.
HF_TOKEN=

# ─── Perfil inicial ──────────────────────────────────────────────────────────
# gpu           = Neste PC (rápido) — tudo local
# gpu-nuvem     = Recomendado (IA) — ouve no PC, traduz com a sua chave
# leve          = IA sem placa de vídeo
# leve-offline  = Neste PC (sem internet)
# Também dá para trocar pelo seletor na interface.
PROFILE=gpu-nuvem

# Idioma da legenda quando a IA está ligada (pt-BR | th | es | ja | …)
# A fala é ouvida neste PC. Só o texto vai para a IA.
TARGET_LANG=pt-BR

# ─── Tradução por IA (só nos perfis com nuvem) ───────────────────────────────
# Qual provedor usar: gemini | openai-compat
TRANSLATOR_BACKEND=gemini

# Quanto esperar pela nuvem antes de desistir e ficar com a legenda local.
# A legenda local já está na tela — isto só limita quanto tempo a revisão pode
# demorar. Acima de ~3s a revisão chega tarde demais para ser útil.
LLM_TIMEOUT_S=5.0

# ── Gemini ───────────────────────────────────────────────────────────────────
# Chave em aistudio.google.com/apikey
GEMINI_API_KEY=
# Medido nesta máquina: 405 tokens de entrada + 32 de saída por revisão, o que
# dá ~US$ 0,03 por hora de reunião no 2.5-flash-lite. O 3.5-flash-lite custa
# ~6x mais na saída; só vale se a qualidade da revisão decepcionar.
# Evite modelos de raciocínio (linha M do MiniMax, gemini com thinking): eles
# demoram 20s+ para o primeiro token de resposta e estouram LLM_TIMEOUT_S sempre.
GEMINI_MODEL=gemini-2.5-flash-lite

# Preço em USD por milhão de tokens, para o contador de gasto da barra de título.
# Só é preciso preencher se o modelo escolhido não estiver na tabela de
# llm_translator.py — sem isto a UI mostra tokens em vez de dinheiro.
# LLM_PRICE_IN=0.10
# LLM_PRICE_OUT=0.40

# ── OpenAI-compatível: cobre GPT, DeepSeek, Kimi e MiniMax ───────────────────
# Só mude LLM_BASE_URL + LLM_MODEL para trocar de provedor.
#
#   OpenAI    https://api.openai.com/v1          gpt-4o-mini
#   DeepSeek  https://api.deepseek.com/v1        deepseek-chat
#   Kimi      https://api.moonshot.ai/v1         moonshot-v1-8k
#   MiniMax   https://api.minimax.io/v1          MiniMax-M2.7-highspeed
#
# Atenção ao escolher: a linha M do MiniMax (M2, M2.5, M2.7, M3) são modelos de
# raciocínio — eles "pensam" antes de responder, e o primeiro token de RESPOSTA
# pode levar 20s+. Isso estoura LLM_TIMEOUT_S sempre e a revisão nunca chega.
# As variantes `-highspeed` geram ~100 tok/s em vez de ~60; se ainda assim toda
# revisão cair em timeout, o caminho é outro provedor, não subir o timeout —
# acima de ~3s a revisão chega depois que a legenda já saiu da tela.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
